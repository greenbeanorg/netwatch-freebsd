+    if let Ok(devices) = pcap::Device::list() {
+        for dev in devices {
+            if let (Some(info), Some(desc)) = (by_name.get_mut(&dev.name), dev.desc) {
+                let desc = desc.trim();
+                if !desc.is_empty() {
+                    info.description = Some(desc.to_string());
+                }
+            }
+        }
+    }
+
     Ok(by_name.into_values().collect())
